DATABASE_URL=postgres://studio:studio_local@127.0.0.1:55439/studio
EVE_URL=http://127.0.0.1:33441
# Required shared secret for the app, worker and Eve; generate at least 32 random characters.
EVE_PASSWORD=
BLENDER_MCP_URL=http://127.0.0.1:33442/mcp
# Native builder endpoint defaults to /workspace on the same origin.
# BLENDER_RUNNER_URL=http://127.0.0.1:33442/workspace
STUDIO_MODEL=gpt-6-sol
WORKER_CONCURRENCY=2
# Material builds use .venv's Python by default. Override for a different environment.
# STUDIO_PYTHON=/absolute/path/to/python
# CAD_PYTHON=/absolute/path/to/.venv-cad/bin/python
# BLENDER_BIN=/absolute/path/to/blender
AGENT_TIMEOUT_MS=1200000
# Builder turns can include several Blender executions and use a larger envelope.
BUILDER_TIMEOUT_MS=2700000
BLENDER_BUILD_TIMEOUT_SECONDS=600
# Single local Eve runtime; override for a multi-instance deployment.
WORKFLOW_INLINE_OWNERSHIP_LEASE_SECONDS=60
# Optional absolute directory; if set, pass the SAME value to app, worker, Eve and MCP.
# STUDIO_DATA_DIR=/absolute/path/to/asset-studio/data
# OPENAI_API_KEY and OPENAI_BASE_URL must be provided privately to Eve.
# scripts/provider.py resolves the existing Codex provider in this environment.
# Optional: Admin → Settings → Image provider "OpenAI API" sends image requests to
# api.openai.com with this key. The Codex gateway ignores requested quality and size.
# OPENAI_IMAGES_API_KEY=

# Roles/models/effort are configured in src/modules/ai/roles.ts.
# Token prices are code-owned per model and snapshotted with every run.
# STUDIO_MODEL is only the fallback for legacy Eve sessions lacking a snapshot.
STUDIO_APP_URL=http://127.0.0.1:3000

# Media storage: Roastbook-compatible local/S3 provider interface.
# Local (default) uses STUDIO_DATA_DIR; file URLs always stay under /api/files.
STORAGE_PROVIDER=local
# S3_BUCKET=studio-media
# S3_REGION=us-east-1
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Set the same storage settings on app and worker; restart both after changing.
# Blender workspaces, Eve sessions and recovery checkpoints still require local data/.

# Remote agent MCP connection with browser OAuth. Run db:migrate first.
# MCP_PUBLIC_URL=https://your-workshop.example/api/mcp
# Dedicated owner consent password; use a random value of at least 32 characters.
# MCP_OWNER_PASSWORD=
# Behind Hodor, set MCP_OWNER_AUTH=hodor instead of an owner password.
# All requests must pass through Hodor and its upstream must be private.
# MCP_OWNER_AUTH=password
# Separate signing secret of at least 32 characters; defaults to owner password.
# MCP_SECRET=
# Optional comma-separated browser client origins; server origin is always allowed.
# MCP_ALLOWED_ORIGINS=https://your-client.example
