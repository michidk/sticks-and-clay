{
  "name": "asset-studio",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:demo": "bun scripts/build-demo.ts",
    "demo:export": "bun scripts/export-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "db:migrate": "bun scripts/migrate.ts",
    "worker": "bun scripts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "services": "bash scripts/services.sh",
    "eve:build": "cd eve && bun ../node_modules/eve/bin/eve.js build",
    "eve:typecheck": "tsc --noEmit -p eve/tsconfig.json",
    "verify": "bun run typecheck && bun run test && bun run build && bun run eve:typecheck",
    "audit": "bun audit --ignore GHSA-hp3w-g68c-fv3c"
  },
  "dependencies": {
