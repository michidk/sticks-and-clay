{
  "name": "asset-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "db:migrate": "bun scripts/migrate.ts",
    "worker": "bun scripts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "services": "bash scripts/services.sh",
    "eve:build": "cd eve && ../node_modules/.bin/eve build",
    "eve:typecheck": "tsc --noEmit -p eve/tsconfig.json",
    "verify": "bun run typecheck && bun run test && bun run build && bun run eve:typecheck"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/ai": "^0.63.0",
    "@tanstack/ai-openai": "^0.25.1",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "ai": "^7.0.105",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "eve": "0.63.0",
    "lucide-react": "^1.46.0",
    "meshoptimizer": "^1.3.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "@tanstack/router-cli": "^1.167.36",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "nitro": "^3.0.260903-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "@types/three": "^0.180.0"
  }
